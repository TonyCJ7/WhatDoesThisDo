{
  "name": "whatdoesthisdo",
  "displayName": "WhatDoesThisDo",
  "description": "Hover over one of your own functions or constants and read what it is for, from markdown pages in the repository that your AI agent keeps up to date. Works in every language.",
  "version": "0.1.2",
  "publisher": "TonyCJ7",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TonyCJ7/WhatDoesThisDo.git"
  },
  "bugs": {
    "url": "https://github.com/TonyCJ7/WhatDoesThisDo/issues"
  },
  "homepage": "https://github.com/TonyCJ7/WhatDoesThisDo#readme",
  "icon": "docs/assets/icon.png",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": ["Other"],
  "keywords": ["hover", "documentation", "markdown", "reference", "docs", "WDTD", "what does this do", "AI documentation", "agent", "Claude Code", "Cursor"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "WhatDoesThisDo",
      "properties": {
        "whatDoesThisDo.folder": {
          "type": "string",
          "default": "docs/whatdoesthisdo/references",
          "description": "Folder, relative to each workspace folder, whose markdown pages hold one entry per function or constant. Subfolders are read too."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test parse.test.js",
    "test:editor": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0"
  }
}
